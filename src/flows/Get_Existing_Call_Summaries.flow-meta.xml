    <description>Flow to be invoked from Generate Call Summaries prompt, to get the existing call summaries and generate a similar call summary for the same opportunity</description>
    <environments>Default</environments>
    <interviewLabel>Get Existing Call Summaries {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Get Existing Call Summaries</label>
    <loops>
        <name>Loop_Call_Summaries</name>
        <label>Loop Call Summaries</label>
        <locationX>176</locationX>
        <locationY>242</locationY>
        <collectionReference>Get_Existing_Call_Summary</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Concatenate_summary</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Send_summary_to_prompt</targetReference>
        </noMoreValuesConnector>
    </loops>
